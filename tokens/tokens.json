{
  "$description": "Arabesque Labs design tokens, in the W3C Design Tokens (DTCG) format. Three layers: primitive (raw values), semantic (roles, with a dark mode under $extensions), and component. scripts/build.mjs turns this into CSS custom properties prefixed --al-. The first path segment (primitive, semantic, component) is dropped from the names.",
  "primitive": {
    "color": {
      "$type": "color",
      "$description": "Named by hue family and OKLCH lightness (so cloud-98 is about 98% lightness). Brand colours are noted with their logo-pack hex.",
      "sand": {
        "93": { "$value": "oklch(92.8% 0.006 100)", "$description": "Pale #E8E7E3" },
        "74": { "$value": "oklch(73.5% 0.012 100)" }
      },
      "cloud": {
        "$description": "Cool, bright neutrals for the light theme (close to Tailwind's slate 50–300, as on mosab.co.uk).",
        "98": { "$value": "oklch(98.4% 0.003 248)", "$description": "#F8FAFC" },
        "96": { "$value": "oklch(96.8% 0.007 248)", "$description": "#F1F5F9" },
        "93": { "$value": "oklch(92.9% 0.013 255)", "$description": "#E2E8F0" },
        "87": { "$value": "oklch(86.9% 0.022 252)", "$description": "#CBD5E1" },
        "45": { "$value": "oklch(44.6% 0.043 257)", "$description": "#475569" },
        "21": { "$value": "oklch(20.8% 0.042 266)", "$description": "#0F172A" }
      },
      "slate": {
        "18": { "$value": "oklch(18.2% 0.017 265)", "$description": "Night #0E121A" },
        "21": { "$value": "oklch(21.2% 0.018 265)" },
        "24": { "$value": "oklch(24.2% 0.018 265)" },
        "62": { "$value": "oklch(62% 0.012 265)" }
      },
      "teal": {
        "43": { "$value": "oklch(43% 0.08 183)", "$description": "The light theme's accent, hovered." },
        "51": { "$value": "oklch(51% 0.095 183)", "$description": "A brighter teal, near #0F766E: the light theme's accent." },
        "83": { "$value": "oklch(82.5% 0.105 168)", "$description": "Mint #7CDCB9" },
        "91": { "$value": "oklch(91% 0.075 168)", "$description": "The dark theme's accent, hovered." }
      },
      "red": {
        "46": { "$value": "oklch(46% 0.18 27)", "$description": "Danger, hovered, in the light theme." },
        "54": { "$value": "oklch(54% 0.21 27)", "$description": "A brighter red, near #DC2626." },
        "68": { "$value": "oklch(68% 0.17 25)" },
        "78": { "$value": "oklch(78% 0.13 25)", "$description": "Danger, hovered, in the dark theme." }
      },
      "amber": {
        "49": { "$value": "oklch(49% 0.105 75)" },
        "80": { "$value": "oklch(80% 0.12 85)" }
      },
      "blue": {
        "53": { "$value": "oklch(53% 0.19 262)", "$description": "A bright blue, near #2563EB." },
        "80": { "$value": "oklch(80% 0.08 250)" }
      },
      "chart": {
        "$description": "Categorical chart hues, in a fixed order, validated for colour-blind separation on both surfaces (dataviz palette validator).",
        "green-light": { "$value": "#007a5c" },
        "orange-light": { "$value": "#c26300" },
        "blue-light": { "$value": "#3d73b6" },
        "raspberry-light": { "$value": "#b8336a" },
        "green-dark": { "$value": "#3ba888" },
        "orange-dark": { "$value": "#ca7e31" },
        "blue-dark": { "$value": "#5188cd" },
        "raspberry-dark": { "$value": "#d75b8f" }
      },
      "white": { "$value": "oklch(100% 0 0)" }
    }
  },
  "semantic": {
    "color": {
      "$type": "color",
      "$description": "Roles. The value is the light theme; $extensions.com.arabesquelabs.modes.dark is the dark theme. Most roles point to a primitive; the exceptions are literal on purpose: translucent colours (washes, line-strong, the backdrop, pattern-line), which are a hue at an alpha that only makes sense for that role, and the tints, which are a fixed palette of their own. Each is still measured by the contrast check.",
      "bg": { "$value": "{primitive.color.cloud.98}", "$description": "The page.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.slate.18}" } } },
      "surface": { "$value": "{primitive.color.white}", "$description": "Cards, panels, dialogs, inputs.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.slate.21}" } } },
      "surface-sunk": { "$value": "{primitive.color.cloud.96}", "$description": "Wells, table stripes, info notices, hover.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.slate.24}" } } },
      "text": { "$value": "{primitive.color.cloud.21}", "$description": "Body text and headings.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.sand.93}" } } },
      "text-muted": { "$value": "{primitive.color.cloud.45}", "$description": "Secondary text, hints, captions.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.sand.74}" } } },
      "line": { "$value": "{primitive.color.cloud.93}", "$description": "Hairlines that separate (decorative: no contrast minimum).", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(100% 0 0 / 0.12)" } } },
      "line-strong": { "$value": "oklch(20.8% 0.042 266 / 0.4)", "$description": "Section rules and dividers that structure a page.", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(100% 0 0 / 0.4)" } } },
      "control": { "$value": "{primitive.color.slate.62}", "$description": "Borders of form controls: at least 3:1 against surfaces (WCAG 1.4.11). The same in both themes." },
      "accent": { "$value": "{primitive.color.teal.51}", "$description": "The brand accent: primary actions, links on hover, focus, selection; and success, with an icon and a word.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.teal.83}" } } },
      "accent-hover": { "$value": "{primitive.color.teal.43}", "$description": "A primary button, hovered: a clear step from the accent, with on-accent still readable.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.teal.91}" } } },
      "on-accent": { "$value": "{primitive.color.white}", "$description": "Text and icons on the accent.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.slate.18}" } } },
      "accent-wash": { "$value": "oklch(60% 0.11 183 / 0.12)", "$description": "Tints: selected rows, highlighted totals.", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(82.5% 0.105 168 / 0.12)" } } },
      "focus": { "$value": "{primitive.color.teal.51}", "$description": "The focus outline.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.teal.83}" } } },
      "focus-on-inverse": { "$value": "{primitive.color.teal.83}", "$description": "The focus outline on the inverse ground (the bulk bar, toasts): the other theme's focus colour.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.teal.51}" } } },
      "danger": { "$value": "{primitive.color.red.54}", "$description": "Errors, and actions that destroy.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.red.68}" } } },
      "danger-hover": { "$value": "{primitive.color.red.46}", "$description": "A filled danger button, hovered.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.red.78}" } } },
      "danger-wash": { "$value": "oklch(63% 0.22 27 / 0.1)", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(68% 0.17 25 / 0.14)" } } },
      "warning": { "$value": "{primitive.color.amber.49}", "$description": "Needs attention soon; experimental.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.amber.80}" } } },
      "warning-wash": { "$value": "oklch(86% 0.16 92 / 0.3)", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(80% 0.12 85 / 0.12)" } } },
      "success": { "$value": "{primitive.color.teal.51}", "$description": "Done, saved, passed: the brand teal, always with an icon and a word, so colour is never the only signal.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.teal.83}" } } },
      "success-wash": { "$value": "oklch(60% 0.11 183 / 0.12)", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(82.5% 0.105 168 / 0.12)" } } },
      "info": { "$value": "{primitive.color.blue.53}", "$description": "Neutral information.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.blue.80}" } } },
      "info-wash": { "$value": "oklch(62% 0.19 262 / 0.1)", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(80% 0.08 250 / 0.12)" } } },
      "backdrop": { "$value": "oklch(20.8% 0.042 266 / 0.45)", "$description": "Behind modal dialogs.", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(0% 0 0 / 0.6)" } } },
      "inverse": { "$value": "{primitive.color.cloud.21}", "$description": "Toasts and tooltips: a dark chip on a light page, and the reverse.", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.sand.93}" } } },
      "on-inverse": { "$value": "{primitive.color.cloud.98}", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.slate.18}" } } },
      "chart-0": { "$value": "{primitive.color.cloud.87}", "$description": "The neutral: the rest, the track.", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(100% 0 0 / 0.2)" } } },
      "chart-1": { "$value": "{primitive.color.chart.green-light}", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.chart.green-dark}" } } },
      "chart-2": { "$value": "{primitive.color.chart.orange-light}", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.chart.orange-dark}" } } },
      "chart-3": { "$value": "{primitive.color.chart.blue-light}", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.chart.blue-dark}" } } },
      "chart-4": { "$value": "{primitive.color.chart.raspberry-light}", "$extensions": { "com.arabesquelabs.modes": { "dark": "{primitive.color.chart.raspberry-dark}" } } },
      "tint": {
        "$description": "Bright tints for tags, highlights and avatars: identity and decoration, never status. Each ink is readable on its ground (4.5:1).",
        "teal": {
          "bg": { "$value": "#CCFBF1", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(70% 0.13 183 / 0.18)" } } },
          "ink": { "$value": "#115E59", "$extensions": { "com.arabesquelabs.modes": { "dark": "#5EEAD4" } } }
        },
        "green": {
          "bg": { "$value": "#DCFCE7", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(72% 0.17 150 / 0.18)" } } },
          "ink": { "$value": "#166534", "$extensions": { "com.arabesquelabs.modes": { "dark": "#86EFAC" } } }
        },
        "yellow": {
          "bg": { "$value": "#FEF9C3", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(85% 0.17 95 / 0.18)" } } },
          "ink": { "$value": "#854D0E", "$extensions": { "com.arabesquelabs.modes": { "dark": "#FDE047" } } }
        },
        "orange": {
          "bg": { "$value": "#FFEDD5", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(75% 0.16 55 / 0.18)" } } },
          "ink": { "$value": "#9A3412", "$extensions": { "com.arabesquelabs.modes": { "dark": "#FDBA74" } } }
        },
        "pink": {
          "bg": { "$value": "#FCE7F3", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(72% 0.17 350 / 0.18)" } } },
          "ink": { "$value": "#9D174D", "$extensions": { "com.arabesquelabs.modes": { "dark": "#F9A8D4" } } }
        },
        "purple": {
          "bg": { "$value": "#F3E8FF", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(70% 0.17 305 / 0.2)" } } },
          "ink": { "$value": "#6B21A8", "$extensions": { "com.arabesquelabs.modes": { "dark": "#D8B4FE" } } }
        },
        "blue": {
          "bg": { "$value": "#DBEAFE", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(68% 0.16 262 / 0.2)" } } },
          "ink": { "$value": "#1E40AF", "$extensions": { "com.arabesquelabs.modes": { "dark": "#93C5FD" } } }
        },
        "cyan": {
          "bg": { "$value": "#CFFAFE", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(75% 0.13 215 / 0.18)" } } },
          "ink": { "$value": "#155E75", "$extensions": { "com.arabesquelabs.modes": { "dark": "#67E8F9" } } }
        }
      },
      "pattern-line": { "$value": "oklch(51% 0.095 183 / 0.24)", "$description": "The tessellation's strands: texture only, never behind body text.", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(100% 0 0 / 0.16)" } } },
      "pattern-scaffold": { "$value": "oklch(51% 0.095 183 / 0.1)", "$description": "Construction lines.", "$deprecated": "Nothing in the system draws construction lines; kept for sites that alias it (hunt). Removed in 0.3.", "$extensions": { "com.arabesquelabs.modes": { "dark": "oklch(100% 0 0 / 0.08)" } } }
    },
    "font": {
      "$type": "fontFamily",
      "$description": "Latin first; each Latin face has no Arabic, so Arabic falls through to its own face in the same stack.",
      "sans": { "$value": ["Jost", "IBM Plex Sans Arabic", "Noto Sans Arabic", "SF Arabic", "Geeza Pro", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Interface text." },
      "display": { "$value": ["Jost", "Kufam", "Noto Kufi Arabic", "IBM Plex Sans Arabic", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Headings and the wordmark." },
      "serif": { "$value": ["Newsreader", "Amiri", "Noto Naskh Arabic", "Scheherazade New", "Georgia", "serif"], "$description": "Reading text." },
      "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "Code and fixed-width figures." }
    },
    "script-scale": { "$type": "number", "$value": 1, "$description": "Multiplies every text size: Arabic is set a little larger to match Latin's apparent size.", "$extensions": { "com.arabesquelabs.modes": { "ar": 1.08 } } },
    "text": {
      "$type": "dimension",
      "$description": "The type scale. Each size is multiplied by --al-script-scale when built.",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.8125rem" },
      "base": { "$value": "0.9375rem", "$description": "Interface body text." },
      "md": { "$value": "1.0625rem", "$description": "Reading text." },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.5rem" },
      "2xl": { "$value": "clamp(1.75rem, 1.5rem + 1vw, 2.25rem)" },
      "3xl": { "$value": "clamp(2rem, 1.5rem + 2vw, 3rem)" },
      "display": { "$value": "clamp(2.5rem, 1.6rem + 3.6vw, 4.75rem)" }
    },
    "leading": {
      "$type": "number",
      "$description": "Line heights; Arabic (the ar mode) needs more room for its ascenders, descenders and marks.",
      "tight": { "$value": 1.1, "$extensions": { "com.arabesquelabs.modes": { "ar": 1.35 } } },
      "heading": { "$value": 1.2, "$extensions": { "com.arabesquelabs.modes": { "ar": 1.45 } } },
      "ui": { "$value": 1.45, "$extensions": { "com.arabesquelabs.modes": { "ar": 1.65 } } },
      "prose": { "$value": 1.6, "$extensions": { "com.arabesquelabs.modes": { "ar": 1.9 } } }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    },
    "tracking": {
      "$type": "dimension",
      "tight": { "$value": "-0.015em", "$extensions": { "com.arabesquelabs.modes": { "ar": "0" } } },
      "none": { "$value": "0" },
      "wide": { "$value": "0.05em", "$description": "The wordmark only. Never on Arabic.", "$extensions": { "com.arabesquelabs.modes": { "ar": "0" } } }
    },
    "space": {
      "$type": "dimension",
      "$description": "A 4px step (0.25rem): space-N is N × 4px.",
      "0": { "$value": "0" },
      "0-5": { "$value": "0.125rem" },
      "1": { "$value": "0.25rem" },
      "1-5": { "$value": "0.375rem" },
      "2": { "$value": "0.5rem" },
      "3": { "$value": "0.75rem" },
      "4": { "$value": "1rem" },
      "5": { "$value": "1.25rem" },
      "6": { "$value": "1.5rem" },
      "8": { "$value": "2rem" },
      "12": { "$value": "3rem" },
      "16": { "$value": "4rem" },
      "section": { "$value": "clamp(3rem, 2rem + 6vw, 9rem)", "$description": "Between website sections." },
      "gutter": { "$value": "clamp(1rem, 0.5rem + 3vw, 4rem)", "$description": "Page side gutter." }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "0.125rem", "$description": "Controls, cards: the brand's crisp edge." },
      "md": { "$value": "0.25rem", "$description": "Chart ends, toasts." },
      "full": { "$value": "999px" }
    },
    "border": {
      "$type": "dimension",
      "hairline": { "$value": "1px" },
      "focus": { "$value": "2px" },
      "focus-offset": { "$value": "2px" }
    },
    "size": {
      "$type": "dimension",
      "control-sm": { "$value": "2rem", "$description": "32px." },
      "control-md": { "$value": "2.5rem", "$description": "40px." },
      "target-min": { "$value": "1.5rem", "$description": "WCAG 2.5.8: every target at least 24 × 24px." },
      "target-touch": { "$value": "2.75rem", "$description": "44px, on coarse pointers." },
      "icon": { "$value": "1.125rem" },
      "measure": { "$value": "65ch", "$description": "The longest line of reading text." },
      "page": { "$value": "75rem" },
      "dialog-sm": { "$value": "30rem" },
      "dialog-md": { "$value": "48rem" },
      "sidebar": { "$value": "14rem" },
      "sidebar-collapsed": { "$value": "3.75rem" }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms", "$description": "Hover, press, feedback." },
      "base": { "$value": "250ms", "$description": "Theme change, disclosure, toasts." }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    },
    "z": {
      "$type": "number",
      "sticky": { "$value": 10 },
      "toast": { "$value": 100 }
    },
    "breakpoint": {
      "$type": "dimension",
      "$description": "For JS and Tailwind; CSS media queries use the literal values (custom properties can't go in media queries).",
      "sm": { "$value": "40rem" },
      "md": { "$value": "52rem" },
      "lg": { "$value": "64rem" }
    },
    "pattern": {
      "$type": "dimension",
      "$description": "The tessellation's geometry, read by js/pattern.js from the custom properties.",
      "side": { "$value": "32px", "$description": "Polygon side on wide screens." },
      "side-narrow": { "$value": "22px", "$description": "Polygon side under the md breakpoint." },
      "stroke": { "$value": "1.25px" },
      "contact-angle": { "$value": 67.5, "$type": "number", "$description": "Degrees." }
    }
  },
  "component": {
    "button": {
      "height": { "$type": "dimension", "$value": "{semantic.size.control-md}" },
      "height-sm": { "$type": "dimension", "$value": "{semantic.size.control-sm}" },
      "padding-inline": { "$type": "dimension", "$value": "{semantic.space.4}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.sm}" }
    },
    "field": {
      "height": { "$type": "dimension", "$value": "{semantic.size.control-md}" },
      "padding-inline": { "$type": "dimension", "$value": "{semantic.space.3}" },
      "radius": { "$type": "dimension", "$value": "{semantic.radius.sm}" }
    }
  }
}
