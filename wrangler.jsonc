{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arabesque-design-system",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // The site, as scripts/site.mjs builds it: the repository and the
  // documents (Docusaurus). Wrangler runs it before a deploy and wrangler dev.
  "build": {
    "command": "node scripts/site.mjs",
    "watch_dir": ["docs", "docusaurus/src", "docusaurus/docusaurus.config.js", "docusaurus/sidebars.js"]
  },
  "assets": {
    "directory": "_site"
  },
  "previews": {}
}
