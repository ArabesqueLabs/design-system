{
  "name": "@arabesquelabs/design-system",
  "version": "0.7.0",
  "description": "Arabesque, the Arabesque Labs design system: tokens, CSS and components, accessible (WCAG 2.2 AA) and bidirectional (English and Arabic).",
  "license": "UNLICENSED",
  "private": true,
  "repository": { "type": "git", "url": "git+https://github.com/ArabesqueLabs/design-system.git" },
  "homepage": "https://design.arabesquelabs.com",
  "bugs": "https://github.com/ArabesqueLabs/design-system/issues",
  "type": "module",
  "files": ["dist", "fonts", "css", "js", "icons", "assets", "tokens"],
  "style": "./dist/arabesque.css",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./dist/arabesque.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./tokens.json": "./dist/tokens.json",
    "./icons.svg": "./dist/icons.svg",
    "./fonts.css": "./fonts/fonts.css",
    "./js/*": "./js/*",
    "./react": { "types": "./dist/react/index.d.ts", "default": "./dist/react/index.js" }
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-react.mjs",
    "build:react": "node scripts/build-react.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "check": "npm run build && node --test \"tests/*.test.js\" && git diff --exit-code -- dist docs examples templates index.html README.html ar/README.html CHANGELOG.html",
    "prepare": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "fonts": "node scripts/fonts.mjs",
    "badges": "node scripts/badges.mjs",
    "serve": "python3 -m http.server 4900 --bind 127.0.0.1"
  },
  "engines": { "node": ">=20" },
  "peerDependencies": { "react": ">=19", "react-dom": ">=19" },
  "peerDependenciesMeta": { "react": { "optional": true }, "react-dom": { "optional": true } },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "marked": "15.0.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
