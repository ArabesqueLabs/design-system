{
  "name": "@arabesquelabs/design-system",
  "version": "0.2.0",
  "description": "The Arabesque Labs design system: tokens, CSS and components, accessible (WCAG 2.2 AA) and bidirectional (English and Arabic).",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "files": ["dist", "fonts", "css", "js", "icons", "assets", "tokens"],
  "style": "./dist/arabesque.css",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./dist/arabesque.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./tokens.json": "./dist/tokens.json",
    "./icons.svg": "./dist/icons.svg",
    "./fonts.css": "./fonts/fonts.css",
    "./js/*": "./js/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "check": "node scripts/build.mjs && node --test \"tests/*.test.js\" && git diff --exit-code -- dist docs/contrast.md",
    "prepare": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "fonts": "node scripts/fonts.mjs",
    "serve": "python3 -m http.server 4900 --bind 127.0.0.1"
  },
  "engines": { "node": ">=20" }
}
